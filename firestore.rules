rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{doc} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
    match /rooms/{code} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
